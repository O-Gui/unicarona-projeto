generator client {
  provider = "prisma-client-js"
  // Habilita a extensão do PostGIS no Prisma
  previewFeatures = ["postgresqlExtensions"] 
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis] // Instala o PostGIS automaticamente
}

// =========================================================================
// TABELAS DO SISTEMA (MODELAGEM UNICARONA)
// =========================================================================

model Usuario {
  id            String         @id @default(uuid()) @db.Uuid
  nome          String
  email         String         @unique
  senhaHash     String
  emailValidado Boolean        @default(false)
  
  // Relacionamentos
  veiculos      Veiculo[]
  rotas         Rota[]
  solicitacoes  Solicitacao[]
  participacoes Participacao[]
}

model Veiculo {
  id              String  @id @default(uuid()) @db.Uuid
  usuarioId       String  @db.Uuid
  placa           String  @unique
  // A validação de 1 a 4 vagas deve ser feita no código do backend (NestJS)
  capacidadeVagas Int     
  
  usuario         Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Rota {
  id           String  @id @default(uuid()) @db.Uuid
  usuarioId    String  @db.Uuid
  
  // Tipo geográfico do PostGIS suportado pelo Prisma
  pontoOrigem  Unsupported("geography(Point, 4326)")
  pontoDestino Unsupported("geography(Point, 4326)")
  
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  caronas      Carona[]
}

model Carona {
  id              String        @id @default(uuid()) @db.Uuid
  rotaId          String        @db.Uuid
  dataHoraPartida DateTime
  
  rota            Rota          @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  solicitacoes    Solicitacao[]
  viagem          Viagem?
}

model Solicitacao {
  id           String  @id @default(uuid()) @db.Uuid
  passageiroId String  @db.Uuid
  caronaId     String  @db.Uuid
  status       String  @default("PENDENTE")
  
  passageiro   Usuario @relation(fields: [passageiroId], references: [id], onDelete: Cascade)
  carona       Carona  @relation(fields: [caronaId], references: [id], onDelete: Cascade)
}

// =========================================================================
// TABELAS DE HISTÓRICO E AUDITORIA (IMUTÁVEIS - Restrict)
// =========================================================================

model Viagem {
  id           String         @id @default(uuid()) @db.Uuid
  caronaId     String         @unique @db.Uuid
  statusViagem String         @default("CONCLUIDA")
  
  carona       Carona         @relation(fields: [caronaId], references: [id], onDelete: Restrict)
  participantes Participacao[]
  avaliacoes    Avaliacao[]
}

model Participacao {
  id        String  @id @default(uuid()) @db.Uuid
  viagemId  String  @db.Uuid
  usuarioId String  @db.Uuid
  
  viagem    Viagem  @relation(fields: [viagemId], references: [id], onDelete: Restrict)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
}

model Avaliacao {
  id       String  @id @default(uuid()) @db.Uuid
  viagemId String  @db.Uuid
  // A validação de nota de 1 a 5 deve ser feita no código do backend (NestJS)
  nota     Int
  
  viagem   Viagem  @relation(fields: [viagemId], references: [id], onDelete: Restrict)
}